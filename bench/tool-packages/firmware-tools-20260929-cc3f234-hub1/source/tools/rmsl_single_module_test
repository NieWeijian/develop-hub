#!/bin/bash
# RK3588 host-side RMSL321 test tool (not shipped in module firmware).
#
# Dev/CI:  ./tools/rmsl_single_module_test package
# Test host: ./rmsl_single_module_test help
#            ./rmsl_single_module_test run [--quick|--long|--preview-only [SEC]]

set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
BIN="$ROOT/bin"

PACKAGE_BINS="uvc_host_ctl uvc_host_stream uvc_host_imu uvc_host_preview uvc_host_isp_test uvc_host_isp_cli uvc_host_ft uvc_host_ota"

FIRMWARE_IMAGES="boot.img system.img oem.img"
FIRMWARE_DIR="${RMSL_TEST_FIRMWARE_DIR:-$ROOT/firmware}"
OTA_COUNT_FILE="${RMSL_TEST_OTA_COUNT_FILE:-$ROOT/.ota_counts}"

usage() {
    cat <<'EOF'
RMSL321 structure-light module test tool (run on RK3588 test host)

Usage:
  ./rmsl_single_module_test help              Show this help (-h / --help)
  ./rmsl_single_module_test run [options]     Run automated tests (recommended)
  ./rmsl_single_module_test package           Build test tarball (developers only)

Examples:
  ./rmsl_single_module_test run               Quick test (same as --quick)
  ./rmsl_single_module_test run --quick       Quick test: all functional items + short stability
  ./rmsl_single_module_test run --long        Long test: fixed multi-round suite + 1 hour stability
  ./rmsl_single_module_test run --long 2      Long test with 2 hour final stability
  ./rmsl_single_module_test run --no-ota      Skip the DFU OTA test item
  ./rmsl_single_module_test run --preview-only          Preview burn-in 1 hour
  ./rmsl_single_module_test run --preview-only 28800    Preview burn-in 8 hours

Run options:
  --quick                 Few minutes: device/ctl/stream/FT/OTA + short stability
                          (no switch rounds; enable with --switch-rounds/--mode-rounds)
  --long [H]              Full suite: + algo switches + dual-mode stream rounds + ISP stress
                          + final stability H hours (default 1)
  --preview-only [SEC]    Preview burn-in: RGB+DEPTH preview + IMU + ctl monitor
                          (default 3600s)
  --switch-rounds N       Algo mode switch rounds (quick=0, long=500)
  --mode-rounds N         Device mode rounds calib->rgb+ir->rgb+depth+ir->rgb+depth (quick=0, long=0)
  --profile-rounds N      USB profile switch rounds high->medium->low->high (quick=1, long=100)
  --fov-rounds N          FOV stop-stream/set/stream/readback rounds (quick=1, long=100)
  --stream-sec N          Stream seconds for stream checks (default quick=20, long=60)
  --isp-rounds N         ISP 3A stress rounds (quick=0, long=200)
  --stability-sec N      Stability soak seconds (overrides quick minutes or long hours)
  --stability-min N       Stability soak minutes in quick mode (default 1)
  --device /dev/videoN    Pin the module under test (multi-module hubs)
  --hidraw /dev/hidrawN   Pin the module's IMU HID node (with --device, use rmsl_multi_module_test)
  --stream-only           Skip ISP stress
  --isp-only              Skip stream monitor
  --no-ctl                Skip control channel test
  --no-stability          Skip the stability soak
  --no-ft                 Skip factory test
  --no-fov                Skip FOV set/stream/readback test
  --no-switch             Skip algo + device mode switch tests
  --no-ota                Skip DFU OTA test
  --no-check              Skip UVC device check
  --no-profile            Skip module USB profile switch check
  --firmware-dir DIR      OTA firmware dir (default: tools/firmware)
  -o DIR                  Session log directory (default: tools/logs/test_YYYYMMDD_HHMMSS)

OTA note: the OTA item flashes BOTH A/B slots completely (oem/system/boot,
boot last so U-Boot can verify it on the next reset)
and leaves the module booting from slot A (production state).  Each slot is
