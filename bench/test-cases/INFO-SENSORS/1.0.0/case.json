{
  "id": "INFO-SENSORS",
  "version": "1.0.0",
  "name": "Sensor / VICAP / ISP 上报",
  "category": "basic",
  "scenario": "telemetry",
  "risk_level": "read_only",
  "command": "sensor-status / vicap-status / isp-status",
  "entrypoint": "test-cases/INFO-SENSORS/1.0.0/run.py",
  "timeout_seconds": 180,
  "parameters": {
    "window_seconds": {
      "type": "number",
      "default": 5
    },
    "fps_tolerance_percent": {
      "type": "number",
      "default": 10
    }
  },
  "assertions": [
    "三个唯一 SC132GS，验证左 IR/右 IR/RGB 角色映射",
    "三个 rkcif 节点齐全，窗口帧计数前进，错误增量为 0",
    "按 RGB 协商帧率及固件分频规则确定各路 Sensor FPS（默认 ±10%），检查上报值和窗口计数速率",
    "三个 rkisp 节点齐全，帧计数前进，ErrCnt/frameloss 增量为 0"
  ],
  "scope": "当前固件；短时上报检查与统计，保存原始数据及开流前后图片；不属于长稳测试",
  "revision": "2026-09-29-negotiated-sensor-fps",
  "required_capabilities": [
    "cli.sensor-status.v1",
    "cli.vicap-status.v1",
    "cli.isp-status.v1",
    "cli.get-param.v1"
  ]
}
