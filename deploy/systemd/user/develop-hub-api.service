[Unit]
Description=RK Testing API and Executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/develop-hub
EnvironmentFile=-%h/develop-hub/.env
Environment=PYTHONPATH=%h/develop-hub/server/src
ExecStartPre=%h/develop-hub/.venv/bin/python -m alembic -c server/alembic.ini upgrade testing@head
ExecStart=%h/develop-hub/.venv/bin/python -m develop_hub.main
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=25
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
