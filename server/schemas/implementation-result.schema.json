{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changed_files", "commit", "tests", "qa_plugin_manifests", "firmware_partitions", "remaining_risks", "blockers"],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "blocked"]},
    "summary": {"type": "string"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "body"],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 10,
          "maxLength": 72,
          "pattern": "^[a-z0-9][a-z0-9_./-]*(?:: [a-z0-9][a-z0-9_./-]*)*: [a-z0-9][ -~]*$"
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"type": "string", "minLength": 4, "maxLength": 100, "pattern": "^- [ -~]+$"}
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": {
          "command": {"type": "string"},
          "result": {"type": "string"}
        }
      }
    },
    "qa_plugin_manifests": {
      "type": "array",
      "items": {"type": "string"}
    },
    "firmware_partitions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}
    },
    "remaining_risks": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
