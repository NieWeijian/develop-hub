# Server
DEVELOP_HUB_ENV=production
DEVELOP_HUB_HOST=0.0.0.0
DEVELOP_HUB_PORT=8175
DEVELOP_HUB_ROOT=/home/nwj/develop-hub
DEVELOP_HUB_AUTO_CREATE_SCHEMA=false

# Phase 1 can run with SQLite WAL:
DEVELOP_HUB_DATABASE_URL=sqlite:////home/nwj/develop-hub/var/develop-hub.db
# For PostgreSQL, replace the line above with:
# DEVELOP_HUB_DATABASE_URL=postgresql+psycopg://develop_hub:CHANGE_ME@127.0.0.1:5432/develop_hub

DEVELOP_HUB_ARTIFACT_ROOT=/home/nwj/develop-hub/var/artifacts
DEVELOP_HUB_WORKTREE_ROOT=/home/nwj/develop-hub/var/worktrees
DEVELOP_HUB_SCHEMA_ROOT=/home/nwj/develop-hub/server/schemas
DEVELOP_HUB_CODEX_BIN=/home/nwj/develop-hub/scripts/run-codex.sh
DEVELOP_HUB_CODEX_REAL_BIN=/home/nwj/.local/bin/codex
DEVELOP_HUB_CODEX_PROXY=
DEVELOP_HUB_CODEX_NO_PROXY=localhost,127.0.0.1,10.10.10.175
DEVELOP_HUB_MAX_CONCURRENT_JOBS=1
DEVELOP_HUB_MAX_REPAIR_ATTEMPTS=2
DEVELOP_HUB_VALIDATION_TIMEOUT_SECONDS=1800
DEVELOP_HUB_CANCEL_GRACE_SECONDS=10

# 3588 QA execution node. Authentication uses the dedicated SSH key; never store the password here.
DEVELOP_HUB_QA_HOST=172.16.38.137
DEVELOP_HUB_QA_PORT=22
DEVELOP_HUB_QA_USER=linaro
DEVELOP_HUB_QA_SSH_KEY=/home/nwj/develop-hub/var/ssh/qa-3588-ed25519
DEVELOP_HUB_QA_WORK_ROOT=/home/linaro/develop-hub-qa
DEVELOP_HUB_QA_CODEX_BIN=/home/linaro/.local/bin/codex
DEVELOP_HUB_QA_OTA_TOOL=/home/linaro/Desktop/DEV-structlight/tools/bin/uvc_host_ota
DEVELOP_HUB_QA_PLUGIN_ROOT=/home/nwj/develop-hub/var/qa-plugins
DEVELOP_HUB_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional; when omitted Codex uses its configured default model.
# DEVELOP_HUB_CODEX_MODEL=

# Used by scripts/run-web.sh when systemd does not inherit the NVM PATH.
DEVELOP_HUB_NPM_BIN=/home/nwj/.nvm/versions/node/v22.22.1/bin/npm
NEXT_PUBLIC_DEVELOP_HUB_PUBLIC_ORIGIN=http://10.10.10.175:3000
