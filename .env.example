# Run commands from the repository root. Local paths default to this directory.
DEVELOP_HUB_ENV=development
DEVELOP_HUB_HOST=127.0.0.1
DEVELOP_HUB_PORT=8175
DEVELOP_HUB_AUTO_CREATE_SCHEMA=false
DEVELOP_HUB_LEGACY_ENABLED=false
# Optional absolute paths (use a fresh database; no legacy migration required):
# DEVELOP_HUB_ROOT=/opt/rk-testing
# DEVELOP_HUB_DATABASE_URL=sqlite:////opt/rk-testing/var/rk-testing.db
# DEVELOP_HUB_ARTIFACT_ROOT=/opt/rk-testing/var/artifacts
DEVELOP_HUB_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# This URL must be reachable from the user's browser; rebuild web after changes.
NEXT_PUBLIC_DEVELOP_HUB_API_URL=http://127.0.0.1:8175
# Register products and SDKs in the web interface. Test stations are installed by the platform.
# DEVELOP_HUB_TEST_STATIONS=/opt/rk-testing/var/test-stations.json
# No Codex account or credentials are needed for the testing platform.
